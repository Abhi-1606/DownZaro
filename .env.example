# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Download Limits & Configuration
MAX_CONCURRENT_JOBS_PER_CLIENT=2
MAX_CONCURRENT_JOBS_GLOBAL=10
MAX_DOWNLOAD_FILE_SIZE_MB=2048
MAX_DURATION_SECONDS=14400
TEMP_DIR=/tmp/downzaro_downloads
TEMP_FILE_TTL_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=300

# Rate Limiting (per client IP)
RATE_LIMIT_INFO_PER_MINUTE=60
RATE_LIMIT_DOWNLOAD_PER_MINUTE=20
RATE_LIMIT_STREAM_PER_MINUTE=120

# Optional Server Cookie Path for Restricted Access (Off by default)
COOKIES_FILE_PATH=

# Auto Update yt-dlp on Startup
YTDLP_AUTO_UPDATE=false
